{
  "manifest_version": 3,
  "name": "Sample Licensed Extension",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://*/*", "https://api.gumroad.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.example.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
