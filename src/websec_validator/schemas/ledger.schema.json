{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/raccioly/websec-validator/schemas/ledger.schema.json",
  "title": "websec-validator findings ledger",
  "description": "Schema for findings-ledger.json and the findings[] of findings.envelope.json. Versioned in lockstep with formats.SCHEMA_VERSION.",
  "type": "object",
  "required": [
    "findings",
    "total"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "suppressed": {
      "type": "integer",
      "minimum": 0
    },
    "by_severity": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "by_confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "dynamic_included": {
      "type": "boolean"
    },
    "calibration": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "coverage": {
      "$ref": "coverage.schema.json"
    },
    "verification_context": {
      "type": "object"
    },
    "attribution": {
      "type": "object",
      "description": "Which change this finding set describes, graded by how much the identity evidence is worth. A SIBLING of verification_context, never merged into it: repairs compares that object by strict dict equality. `assurance` is COMPUTED from what was observed and is never accepted as input.",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "assurance": {
          "enum": [
            "ci-minted",
            "vcs-observed",
            "self-asserted",
            "none"
          ]
        },
        "vcs": {
          "type": "object",
          "description": "Tier 2 \u2014 observed from the repository itself."
        },
        "ci": {
          "type": "object",
          "description": "Tier 1 \u2014 injected by a recognised CI runner; corroborable against the forge."
        },
        "declared": {
          "type": "object",
          "description": "Tier 3 \u2014 operator-declared, NOT verified, never promoted."
        },
        "approver_independence": {
          "type": "object",
          "description": "Always evidenced:false \u2014 websec records the run side only."
        }
      }
    },
    "gate": {
      "type": "object",
      "properties": {
        "failure_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "findings",
            "incomplete",
            "findings+incomplete",
            null
          ],
          "description": "Which condition produced a non-zero exit. A run that is BOTH gate-failing and incomplete exits 1 (the definite fact) and records 'findings+incomplete' here, so the collapse to one exit code loses nothing."
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ],
          "description": "0 clean \u00b7 1 findings at threshold \u00b7 2 usage/config error \u00b7 3 checks incomplete."
        },
        "incomplete": {
          "type": "boolean"
        }
      }
    },
    "clusters": {
      "type": "array",
      "description": "PRESENTATION-ONLY grouping of findings[] into distinct issues. Never affects total, by_severity, the gate count, per-site fingerprints, SARIF results or baselines \u2014 every site remains its own gating finding.",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "kind",
          "site_count",
          "sites"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "rule",
              "incident"
            ],
            "description": "rule = one detector at N sites; incident = secrets removed from the working tree in the same commit."
          },
          "rule": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "attack_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "site_count": {
            "type": "integer",
            "minimum": 1
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "representative": {
            "type": [
              "string",
              "null"
            ]
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": "string"
          },
          "gating_note": {
            "type": "string"
          }
        }
      }
    },
    "cluster_summary": {
      "type": "object",
      "properties": {
        "clusters": {
          "type": "integer"
        },
        "clustered_findings": {
          "type": "integer"
        },
        "distinct_issues": {
          "type": "integer"
        },
        "total_findings": {
          "type": "integer"
        },
        "largest": {
          "type": "integer"
        }
      }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "title",
        "attack_class",
        "severity",
        "confidence",
        "location"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "attack_class": {
          "type": "string",
          "description": "Stable key into the STANDARDS/REMEDIATION maps (e.g. 'ssrf', 'xss', 'clickjacking', 'csrf', 'missing-auth')."
        },
        "severity": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "location": {
          "type": "string",
          "description": "Repo-relative file path, or a prose placeholder like '(response headers)'."
        },
        "fingerprint": {
          "type": "string",
          "description": "Canonical v2 semantic finding identifier; title and mutable intelligence are excluded."
        },
        "baseline_state": {
          "type": "string",
          "enum": [
            "new",
            "unchanged",
            "changed",
            "reopened"
          ],
          "description": "Internal lifecycle state; formats maps changed/reopened to the SARIF updated enum."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layer": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "standards": {
          "type": "object",
          "properties": {
            "cwe": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "asvs": {
              "type": "string"
            },
            "owasp_api": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "remediation": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "calibrated": {
          "type": "object",
          "properties": {
            "p": {
              "type": [
                "number",
                "null"
              ]
            },
            "ci": {
              "type": [
                "array",
                "null"
              ]
            },
            "n": {
              "type": [
                "integer",
                "null"
              ]
            },
            "basis": {
              "type": "string"
            }
          }
        },
        "fingerprint_version": {
          "const": 2
        },
        "fingerprint_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sarif": {
          "type": "object",
          "description": "Untrusted native SARIF evidence; producer suppression, baseline and source freshness claims do not replace local policy."
        },
        "sarif_occurrences": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "in_tree": {
          "type": "boolean",
          "description": "Is the finding's file present in the working tree? false = the file is gone but the blob is still reachable in git history, so the credential is NOT remediated until it is rotated."
        },
        "history_only": {
          "type": "boolean",
          "description": "Secret found only in git history; the file no longer exists."
        },
        "commit": {
          "type": "string",
          "description": "Full commit SHA the secret was observed in (from the scanner's own record)."
        },
        "commit_short": {
          "type": "string",
          "description": "First 12 characters of `commit`, for display."
        },
        "commit_date": {
          "type": "string",
          "description": "ISO timestamp of that commit."
        },
        "commit_author": {
          "type": "string",
          "description": "Author recorded on that commit."
        }
      }
    }
  }
}
