{
  "$schema": "https://raccioly.github.io/docguard/schemas/docguard-config.schema.json",
  "projectName": "websec-validator",
  "version": "0.5",
  "profile": "cli",
  "projectType": "library",
  "projectTypeConfig": {
    "needsEnvVars": false,
    "needsEnvExample": false,
    "needsE2E": false,
    "needsDatabase": false
  },
  "requiredFiles": {
    "canonical": [
      "docs-canonical/ARCHITECTURE.md",
      "docs-canonical/SECURITY.md",
      "docs-canonical/TEST-SPEC.md",
      "docs-canonical/ENVIRONMENT.md",
      "docs/METHODOLOGY.md"
    ]
  },
  "validators": {
    "structure": true,
    "docsSync": true,
    "drift": true,
    "changelog": true,
    "testSpec": true,
    "environment": true,
    "security": false,
    "architecture": false,
    "freshness": true,
    "traceability": true,
    "docsDiff": true,
    "apiSurface": true,
    "metadataSync": true,
    "docsCoverage": true,
    "docQuality": true,
    "todoTracking": true,
    "schemaSync": true,
    "specKit": true,
    "documentLifecycle": true,
    "specRegistry": true,
    "evidence": true,
    "crossReference": true,
    "generatedStaleness": true,
    "canonicalSync": true,
    "surfaceSync": true,
    "diffSuspicion": true,
    "referenceExistence": true,
    "apiDocSmells": true,
    "metricsConsistency": true
  },
  "severity": {}
}
