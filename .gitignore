# websec-validator outputs — hold findings + tokens once probes run; never commit
websec-out/
websec-corpus/
security/
dynamic-config.json
# self-improving calibration overlay — your private confirmed labels (normally lives in ~/.cache; never commit)
calibration-local.json

# private reference material (prior client engagement — large + contains real secrets/findings)
base-research/

# local agent tooling (OpenWolf brain + Claude config + daemon state) — machine-local, not the product
.wolf/
.claude/
CLAUDE.md
# ...EXCEPT the agent_config extractor's test fixtures — a `.claude/`/`CLAUDE.md` under tests/ is
# deliberate test DATA (a benign + a poisoned config), so it must be tracked or CI's fresh checkout
# fails the P2 tests. Re-include them past the two rules above.
!tests/fixtures/**/.claude/
!tests/fixtures/**/CLAUDE.md
# DocGuard / Spec Kit agent tooling — auto-installed skills + slash commands + runtime cache.
# The PRODUCT (committed): .docguard.json, .docguardignore, docs-canonical/, AGENTS.md, CHANGELOG.md, DRIFT-LOG.md
.docguard/
.agent/
commands/
.specify/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# secrets / env
.env
*.env

.DS_Store
